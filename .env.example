# --- App ---
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Used by the app processes (bot/admin) running on the host or in Docker.
DATABASE_URL=postgresql+asyncpg://dorsotbot:dorsotbot@localhost:5432/dorsotbot
# Used only by tests (tests/conftest.py). Create this DB once, see README.
TEST_DATABASE_URL=postgresql+asyncpg://dorsotbot:dorsotbot@localhost:5432/dorsotbot_test

# --- Telegram Bot ---
# Get a real token from @BotFather (/newbot). A placeholder is fine for development —
# the app never fails to start because of it; only actual Telegram sends are skipped.
BOT_TOKEN=123456:PLACEHOLDER-TOKEN-REPLACE-ME
# Marketing channel users must subscribe to before using the bot. Use @username or -100xxxxxxxxxx.
MARKETING_CHANNEL_ID=@your_channel_username
# Group chat where new-order notifications are posted (bot must be a member). Use -100xxxxxxxxxx.
ADMIN_GROUP_CHAT_ID=-1000000000000
SUPPORT_CONTACT=@your_support_username

# --- Admin panel ---
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000

# --- Business rules ---
MIN_ORDER_TOTAL=50000
